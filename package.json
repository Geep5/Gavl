{
  "name": "gavl",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Gavl — a decentralized, ephemeral BTC↔LTC atomic-swap order board on a Proof-of-Space-Time chain over Nostr; swaps settle on-chain via Taproot HTLCs.",
  "scripts": {
    "dev": "concurrently -n daemon,desktop -c blue,magenta \"npm:daemon\" \"npm:desktop\"",
    "dev:hash": "concurrently -n daemon,desktop -c blue,magenta \"npm:daemon:hash\" \"npm:desktop\"",
    "dev:fresh": "concurrently -n daemon,desktop -c blue,magenta \"npm:daemon:fresh\" \"npm:desktop\"",
    "desktop": "cd desktop && cargo run --release",
    "daemon": "node src/server.ts",
    "daemon:hash": "cross-env GAVL_VDF=hash GAVL_SPACE=standin node src/server.ts",
    "daemon:fresh": "cross-env GAVL_VDF=hash GAVL_SPACE=standin GAVL_PERSIST=off node src/server.ts",
    "node:spawn": "node scripts/spawn-node.mjs",
    "test": "node --test \"test/*.test.ts\"",
    "test:fast": "node --test test/consensus.test.ts test/consensus-gossip.test.ts test/ledger.test.ts test/post-cooldown.test.ts test/sync.test.ts",
    "test:chia": "node --test test/chia.test.ts",
    "regtest:install": "node scripts/regtest/install.mjs",
    "test:regtest": "cross-env GAVL_REGTEST=1 node --test \"test/regtest/*.test.ts\"",
    "test:e2e": "cross-env GAVL_REGTEST=1 GAVL_E2E=1 node --test test/regtest/e2e.test.ts",
    "setup:chia": "node scripts/setup_chia.mjs",
    "demo": "node src/index.ts"
  },
  "engines": {
    "node": ">=23.6"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.2",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "typescript": "^5.6.0",
    "ws": "^8.22.1"
  },
  "dependencies": {
    "@noble/curves": "^2.2.0",
    "@scure/base": "^2.2.0",
    "@scure/btc-signer": "^2.2.0",
    "nostr-tools": "^2.24.1"
  }
}
